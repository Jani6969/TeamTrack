{
  "info": {
    "name": "TeamTrack - Weekly Report & Dashboard API",
    "_postman_id": "teamtrack-api-v1",
    "description": "Postman collection for TeamTrack Weekly Report Generator & Team Dashboard Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "reportId",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as Manager",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    console.log('Manager token saved to collection variable');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login as Team Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    console.log('Member token saved to collection variable');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"member1@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"TEAM_MEMBER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Projects",
      "item": [
        {
          "name": "Get All Projects",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"]
            }
          }
        },
        {
          "name": "Create Project (Manager Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AI Chat Assistant Integration\",\n  \"description\": \"Building contextual customer support copilot\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"]
            }
          }
        },
        {
          "name": "Update Project (Manager Only)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Project Name\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}"]
            }
          }
        },
        {
          "name": "Delete Project (Manager Only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Team Member Reports",
      "item": [
        {
          "name": "Get My Reports",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/my?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "my"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Create Report Draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weekStart\": \"2026-09-01T00:00:00.000Z\",\n  \"weekEnd\": \"2026-09-05T23:59:59.000Z\",\n  \"project\": \"{{projectId}}\",\n  \"tasks\": [\n    {\n      \"taskName\": \"Implement OAuth login\",\n      \"priority\": \"HIGH\",\n      \"plannedPercentage\": 100,\n      \"actualPercentage\": 100,\n      \"status\": \"COMPLETED\",\n      \"plannedHours\": 16,\n      \"actualHours\": 18,\n      \"deliverable\": \"PR #10 merged\"\n    }\n  ],\n  \"plannedTasks\": \"Next week: integrate refresh token rotation\",\n  \"blockers\": \"\",\n  \"keyBlocker\": \"\",\n  \"achievements\": \"OAuth login completed ahead of demo\",\n  \"keyAchievement\": \"Zero security vulnerabilities found in audit\",\n  \"hoursWorked\": {\n    \"development\": 25,\n    \"testing\": 8,\n    \"meetings\": 4,\n    \"documentation\": 2,\n    \"other\": 1\n  },\n  \"notes\": \"Ready for review\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reports",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports"]
            }
          }
        },
        {
          "name": "Get Single Report",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "{{reportId}}"]
            }
          }
        },
        {
          "name": "Edit Report (Owner Only - DRAFT or NEEDS_CORRECTION)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Updated notes following manager feedback\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "{{reportId}}"]
            }
          }
        },
        {
          "name": "Submit Report (DRAFT -> SUBMITTED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "{{reportId}}", "submit"]
            }
          }
        },
        {
          "name": "Resubmit Report (NEEDS_CORRECTION -> SUBMITTED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}/resubmit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "{{reportId}}", "resubmit"]
            }
          }
        },
        {
          "name": "Get Report Review History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/{{reportId}}/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "{{reportId}}", "reviews"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Manager Reports",
      "item": [
        {
          "name": "Get All Team Reports (Manager Only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/manager/reports?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "manager", "reports"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "SUBMITTED", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Team Report by ID (Manager Only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/manager/reports/{{reportId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "manager", "reports", "{{reportId}}"]
            }
          }
        },
        {
          "name": "Approve Report (Manager Only - SUBMITTED -> APPROVED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"Great job this week! Approved.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/manager/reports/{{reportId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "manager", "reports", "{{reportId}}", "approve"]
            }
          }
        },
        {
          "name": "Request Correction (Manager Only - SUBMITTED -> NEEDS_CORRECTION)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"Please update the actual hours for the testing task and attach PR link.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/manager/reports/{{reportId}}/request-correction",
              "host": ["{{baseUrl}}"],
              "path": ["api", "manager", "reports", "{{reportId}}", "request-correction"]
            }
          }
        }
      ]
    },
